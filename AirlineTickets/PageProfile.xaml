<Page x:Class="AirlineTickets.PageProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="800" Height="600" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Личный кабинет" FontSize="24" FontWeight="Bold"
                       Foreground="#1565C0" Margin="0,0,0,20"/>

            <!-- Информация о роли -->
            <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#1976D2" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ваша роль: " FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="txtRole" Text="—" FontSize="14" Foreground="#1976D2"/>
                </StackPanel>
            </Border>

            <!-- Форма редактирования -->
            <Border Grid.Row="2" Background="White" BorderBrush="#BBDEFB" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Фамилия -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Фамилия" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtSurname" Height="32" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errSurname" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Имя -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Имя" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtName" Height="32" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errName" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Отчество -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Отчество" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtPatronymic" Height="32" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errPatronymic" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Логин (только для чтения) -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Логин" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtLogin" Height="32" IsReadOnly="True" Background="#F5F5F5"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Email" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtEmail" Height="32" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errEmail" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Телефон -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Телефон" Margin="0,0,0,4" Foreground="#444"/>
                        <TextBox x:Name="txtPhone" Height="32" TextChanged="Field_TextChanged" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        <TextBlock x:Name="errPhone" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Новый пароль -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="Новый пароль (оставьте пустым, если не хотите менять)" Margin="0,0,0,4" Foreground="#444"/>
                        <PasswordBox x:Name="passNewPassword" Height="32" PasswordChanged="Password_TextChanged"/>
                        <TextBlock x:Name="errPassword" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Подтверждение пароля -->
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="Повторите новый пароль" Margin="0,0,0,4" Foreground="#444"/>
                        <PasswordBox x:Name="passConfirmPassword" Height="32" PasswordChanged="Password_TextChanged"/>
                        <TextBlock x:Name="errPasswordConfirm" Foreground="Red" FontSize="11" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Назад" Click="Back_Click" Width="120" Height="36" Margin="0,0,12,0"/>
                <Button x:Name="btnSave" Content="Сохранить изменения" Click="Save_Click"
                        Background="#4CAF50" Foreground="White" Width="200" Height="36"
                        FontSize="14" FontWeight="Bold" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</Page>