<Page x:Class="AirlineTickets.PageReg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="400"
      Title="Регистрация">
    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="-45,0,-64,0">
        <Grid Width="461" Height="776" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid.Background>
                <ImageBrush ImageSource="/av.jpg"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="62*"/>
                <RowDefinition Height="693*"/>
                <RowDefinition Height="21*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,10,0,20" Grid.Row="0"/>

            <Grid Grid.Row="1" Margin="10,0,10,0" Grid.RowSpan="2">
                <!-- Имя -->
                <TextBlock Text="Имя" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtname" Height="28" Margin="0,24,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="errName" Foreground="#FF6666" FontSize="10" Margin="0,56,0,0" Visibility="Collapsed"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,80,0,4"/>
                <TextBox x:Name="txtsurn" Height="28" Margin="0,104,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="errSurn" Foreground="#FF6666" FontSize="10" Margin="0,136,0,0" Visibility="Collapsed"/>

                <!-- Отчество (необязательное) -->
                <TextBlock Text="Отчество" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,160,0,4"/>
                <TextBox x:Name="txtpatr" Height="28" Margin="0,184,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="errPatr" Foreground="#FF6666" FontSize="10" Margin="0,216,0,0" Visibility="Collapsed"/>

                <!-- Логин -->
                <TextBlock Text="Логин" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,240,0,4"/>
                <TextBox x:Name="txtlog" Height="28" Margin="0,264,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="errLog" Foreground="#FF6666" FontSize="10" Margin="0,296,0,0" Visibility="Collapsed"/>

                <!-- Почта -->
                <TextBlock Text="Почта" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,320,0,4"/>
                <TextBox x:Name="txtemail" Height="28" Margin="0,344,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         TextChanged="Field_TextChanged"/>
                <TextBlock x:Name="errEmail" Foreground="#FF6666" FontSize="10" Margin="0,376,0,0" Visibility="Collapsed"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,400,0,4"/>
                <TextBox x:Name="txtphon" Height="28" Margin="0,424,0,0" VerticalAlignment="Top" 
                         Background="#FF131313" Foreground="White" BorderThickness="1"
                         PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="Phone_TextChanged"/>
                <TextBlock x:Name="errPhone" Foreground="#FF6666" FontSize="10" Margin="0,456,0,0" Visibility="Collapsed"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,480,0,4"/>
                <PasswordBox x:Name="passw" Height="28" Margin="0,504,0,0" VerticalAlignment="Top" 
                             Background="#FF131313" Foreground="White" BorderThickness="1"
                             PasswordChanged="Password_TextChanged"/>
                <TextBlock x:Name="errPass" Foreground="#FF6666" FontSize="10" Margin="0,536,0,0" Visibility="Collapsed"/>

                <!-- Повтор пароля -->
                <TextBlock Text="Повторите пароль" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,560,0,4"/>
                <PasswordBox x:Name="passwcheck" Height="28" Margin="0,584,0,0" VerticalAlignment="Top" 
                             Background="#FF131313" Foreground="White" BorderThickness="1"
                             PasswordChanged="Password_TextChanged"/>
                <TextBlock x:Name="errPassCheck" Foreground="#FF6666" FontSize="10" Margin="0,616,0,0" Visibility="Collapsed"/>

                <!-- Кнопка -->
                <Button x:Name="btnreg" Content="Зарегистрироваться" 
                        Margin="0,660,0,0" VerticalAlignment="Top" Height="36" 
                        Background="#FF1E88E5" Foreground="White" FontWeight="Bold" FontSize="16"
                        IsEnabled="False" Click="btnreg_Click"/>
            </Grid>
        </Grid>
    </Viewbox>
</Page>