<Page x:Class="AirlineTickets.PageCart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Корзина и оформление заказа">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Корзина и оформление заказа"
                       FontSize="22" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>

            <ListView x:Name="listCart" Grid.Row="1" MinHeight="80" MaxHeight="280"
                      BorderBrush="#BBDEFB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="listCart_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#1976D2" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold" FontSize="15">
                                        <Run Text="{Binding Offer.AirlineName}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding Offer.FlightNumber}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Foreground="#444">
                                        <Run Text="{Binding Offer.DepartureCity}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding Offer.ArrivalCity}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Offer.DepartureTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#666"
                                               Text="{Binding Offer.TicketDescription}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                    <Button Content="−" Width="28" Height="28" Click="Decrease_Click" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Quantity}" Width="24" FontSize="16"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <Button Content="+" Width="28" Height="28" Click="Increase_Click" Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N0} ₽}"
                                               FontSize="18" FontWeight="Bold" Foreground="#1976D2"
                                               HorizontalAlignment="Right"/>
                                    <Button Content="Удалить" Click="Remove_Click" Margin="0,6,0,0"
                                            HorizontalAlignment="Right" Padding="8,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="txtCartEmpty" Grid.Row="1"
                       Text="Корзина пуста. Выберите рейс в каталоге."
                       Foreground="#888" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"/>

            <TextBlock x:Name="txtTotal" Grid.Row="2" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Right" Margin="0,8,4,8" Foreground="#1565C0"/>

            <Border Grid.Row="3" Background="White" BorderBrush="#BBDEFB" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,4,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    

                    <!-- Под полем Телефон -->
                

                    <!-- Под полем Серия паспорта -->
                   

                    <!-- Под полем Номер паспорта -->
                    

                    <!-- Под полем Email -->
                   
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Данные пассажира"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="ФИО (фамилия и имя)" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtFullName" Height="28" TextChanged="Field_TextChanged" MaxLength="60"/>
                        <TextBlock x:Name="errFio" Text="Минимум 3 буквы" Foreground="Red" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Телефон" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPhone" Height="28" TextChanged="Phone_TextChanged" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        <TextBlock x:Name="errPhone" Text="Введите 11 цифр (например, 89991234567)" Foreground="Red" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="Серия паспорта" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPassportSeries" Height="28" MaxLength="4" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errSeries" Text="Ровно 4 цифры" Foreground="Red" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Номер паспорта" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPassportNumber" Height="28" MaxLength="6" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="Field_TextChanged"/>
                        <TextBlock x:Name="errNumber" Text="Ровно 6 цифр" Foreground="Red" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="Email" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Height="28" TextChanged="Field_TextChanged" MaxLength="30"/>
                        <TextBlock x:Name="errEmail" Text="Некорректный email" Foreground="Red" FontSize="11" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock Text="Способ оплаты" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbPayment" Height="28">
                            <ComboBoxItem Content="Банковская карта" IsSelected="True"/>
                            <ComboBoxItem Content="СБП"/>
                            <ComboBoxItem Content="Наличные в кассе"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,16">
                <Button x:Name="btnBackToFlights" Content="К рейсам" Click="Back_Click"
                        Width="140" Height="36" Margin="6,0"/>
                <Button x:Name="btnCheckout" Content="Оформить заказ" Click="Checkout_Click"
                        Background="#1976D2" Foreground="White"
                        Width="180" Height="36" Margin="6,0" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Row="5">
                <TextBlock Text="История заказов" FontSize="18" FontWeight="Bold"
                           Foreground="#1565C0" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtHistoryEmpty" Text="Заказов пока нет." Foreground="#888" Margin="0,0,0,8"/>
                <ListView x:Name="listHistory" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding BookingNumber}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding DateText}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding RouteText}"/>
                                        <TextBlock Margin="0,2,0,0" Foreground="#666" Text="{Binding Status}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold"
                                               Foreground="#1976D2" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Text="{Binding TotalText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
